generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  PILOTO
}

enum Disciplina {
  RALLY
  CIRCUITO
  DRIFT
  KARTCROSS
  MONOPLAZA
  SUBIDAS
}

enum EstadoCampeonato {
  PROXIMO
  ACTIVO
  FINALIZADO
}

enum EstadoCarrera {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
}

enum EstadoInscripcion {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum CanalChat {
  GENERAL
  RALLY
  CIRCUITO
  ANUNCIOS
}

enum TipoNotificacion {
  CARRERA_PROXIMA
  RESULTADO_PUBLICADO
  INSCRIPCION_CONFIRMADA
  NUEVA_CARRERA
  NUEVO_CAMPEONATO
  SUSCRIPCION_ACTIVA
  SUSCRIPCION_CANCELADA
  NUEVO_ELITE
  INVITACION_EQUIPO
  EQUIPO
  TEMPORADA
  MENSAJE_DIRECTO
  REFERIDO
}

enum PlanSuscripcion {
  ROOKIE
  AMATEUR
  PRO
  ELITE
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  EXPIRADA
  PENDIENTE
  GRATUITA
}

enum UbicacionPatrocinador {
  LANDING
  SIDEBAR
  CAMPEONATOS
  ACADEMIA
  TODAS
}

enum TipoQueja {
  INCIDENCIA_CARRERA
  QUEJA_GENERAL
}

enum EstadoQueja {
  ABIERTA
  EN_REVISION
  RESUELTA
  ARCHIVADA
}

enum TipoSancion {
  ADVERTENCIA
  PENALIZACION_PUNTOS
  EXCLUSION_CARRERA
  SUSPENSION_TEMPORAL
  BAN_PERMANENTE
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  emailVerified  DateTime?
  password       String?
  role           Rol       @default(PILOTO)
  avatar         String?
  pais           String?
  bio            String?
  silenciado     Boolean   @default(false)
  baneado        Boolean   @default(false)
  motivoBan      String?
  fechaRegistro  DateTime  @default(now())
  totalPuntos    Int       @default(0)
  totalCarreras  Int       @default(0)
  totalVictorias Int       @default(0)
  totalPodios    Int       @default(0)

  esFounder      Boolean   @default(false) // true si fue uno de los primeros 30 en pagar
  fechaFounder   DateTime? // cuando se convirtió en fundador
  descuentoMerch Int       @default(0) // % de descuento en merch según plan: 0, 10, 15 o 25

  // Programa de referidos
  descuentoReferido         Boolean @default(false) // true si usó un código al registrarse
  codigoReferidoPendienteId String? // código usado en el registro, pendiente de vincular al completar el primer pago

  accounts            Account[]
  sessions            Session[]
  inscripciones       Inscripcion[]
  resultados          Resultado[]
  mensajes            MensajeChat[]
  notificaciones      Notificacion[]
  suscripcion         Suscripcion?
  cochesDesbloqueados CocheDesbloqueado[]
  accionesAdmin       LogAccionAdmin[]    @relation("AdminAcciones")
  accionesRecibidas   LogAccionAdmin[]    @relation("TargetAcciones")
  clasesVistas        ClaseVista[]
  quejasPresentadas   Queja[]             @relation("QuejaDenunciante")
  quejasRecibidas     Queja[]             @relation("QuejaDenunciado")
  pruebasAportadas    PruebaQueja[]

  // Equipos y mensajería. Un piloto puede haber liderado varios equipos a lo largo del tiempo
  // (los equipos disueltos se conservan por su histórico de puntos), así que es una lista.
  equiposLiderados      Equipo[]           @relation("LiderEquipo")
  miembroEquipo         MiembroEquipo?
  invitacionesRecibidas InvitacionEquipo[] @relation("InvitacionesRecibidas")
  mensajesEquipo        MensajeEquipo[]
  mensajesEnviados      MensajeDirecto[]   @relation("MensajesEnviados")
  mensajesRecibidos     MensajeDirecto[]   @relation("MensajesRecibidos")
  propuestasEquipo      PropuestaEquipo[]

  codigosCreados        CodigoReferido[]      @relation("CodigosCreados")
  referidoPor           UsoReferido?          @relation("ReferidoPor")
  referidosHechos       UsoReferido[]         @relation("ReferidosHechos")
  saldoReferidor        SaldoReferidor?
  comisionesGeneradas   ComisionReferido[]    @relation("ComisionesReferidor")
  liquidacionesReferido LiquidacionReferido[] @relation("LiquidacionesReferidor")
  liquidacionesHechas   LiquidacionReferido[] @relation("LiquidacionesAdmin")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Campeonato {
  id                  String           @id @default(cuid())
  nombre              String
  disciplina          Disciplina
  descripcion         String
  estado              EstadoCampeonato @default(PROXIMO)
  fechaInicio         DateTime
  fechaFin            DateTime
  maxPilotos          Int              @default(20)
  imagen              String?
  modsReq             String?
  numEtapas           Int              @default(1)
  categoriaMinima     PlanSuscripcion  @default(ROOKIE)
  soloElite           Boolean          @default(false) // si true, solo usuarios con plan Elite activo pueden inscribirse
  esCampeonatoEquipos Boolean          @default(false) // si true, solo se inscriben equipos (no pilotos individuales)
  temporadaId         String?
  creadoEn            DateTime         @default(now())

  temporada           Temporada?          @relation(fields: [temporadaId], references: [id], onDelete: SetNull)
  carreras            Carrera[]
  inscripciones       Inscripcion[]
  inscripcionesEquipo InscripcionEquipo[]
  sistemaPuntos       SistemaPuntos[]

  @@map("campeonatos")
}

model Carrera {
  id               String        @id @default(cuid())
  campeonatoId     String
  nombre           String
  circuito         String
  fecha            DateTime
  duracionMin      Int           @default(60)
  estado           EstadoCarrera @default(PROGRAMADA)
  servidorIP       String?
  servidorPassword String?
  transmisionUrl   String?
  modsRequeridos   String?

  vueltas         Int?
  coche           String?
  linkModCircuito String?
  linkModCoche    String?
  origenSheet     Boolean @default(false)

  campeonato Campeonato  @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  resultados Resultado[]
  quejas     Queja[]

  @@map("carreras")
}

model Inscripcion {
  id               String            @id @default(cuid())
  userId           String
  campeonatoId     String
  estado           EstadoInscripcion @default(PENDIENTE)
  fechaInscripcion DateTime          @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campeonato Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)

  @@unique([userId, campeonatoId])
  @@map("inscripciones")
}

model Resultado {
  id           String   @id @default(cuid())
  carreraId    String
  userId       String
  posicion     Int
  puntos       Int      @default(0)
  vueltaRapida Boolean  @default(false)
  abandono     Boolean  @default(false)
  tiempo       String?
  equipoId     String? // equipo por el que corrió (solo campeonatos de equipos): los puntos no cambian de equipo si el piloto se va
  creadoEn     DateTime @default(now())

  carrera Carrera @relation(fields: [carreraId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipo  Equipo? @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@unique([carreraId, userId])
  @@map("resultados")
}

model SistemaPuntos {
  id           String @id @default(cuid())
  campeonatoId String
  posicion     Int
  puntos       Int

  campeonato Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)

  @@unique([campeonatoId, posicion])
  @@map("sistema_puntos")
}

model MensajeChat {
  id        String    @id @default(cuid())
  userId    String
  canal     CanalChat @default(GENERAL)
  contenido String
  eliminado Boolean   @default(false)
  creadoEn  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mensajes_chat")
}

model Notificacion {
  id       String           @id @default(cuid())
  userId   String
  tipo     TipoNotificacion
  mensaje  String
  leida    Boolean          @default(false)
  link     String?
  creadoEn DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

model Suscripcion {
  id                    String            @id @default(cuid())
  userId                String            @unique
  plan                  PlanSuscripcion
  estado                EstadoSuscripcion @default(ACTIVA)
  precioMensual         Float
  fechaInicio           DateTime          @default(now())
  fechaRenovacion       DateTime
  fechaCancelacion      DateTime?
  esGratuita            Boolean           @default(false)
  fechaExpiracionManual DateTime?
  planAnterior          PlanSuscripcion?
  notasAdmin            String?
  paypalSubscriptionId  String?           @unique
  paypalOrderId         String?
  esFounder             Boolean           @default(false) // precio fundador congelado de por vida
  precioFounder         Float? // precio fundador original guardado (para referencia histórica)
  creadoEn              DateTime          @default(now())
  actualizadoEn         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suscripciones")
}

model Coche {
  id           String          @id @default(cuid())
  nombre       String
  disciplina   Disciplina
  planMinimo   PlanSuscripcion
  descripcion  String? // descripción con humor del coche
  imagen       String? // legacy — usar imagenUrl
  imagenUrl    String? // URL de imagen genérica del coche
  linkDescarga String? // URL de Google Drive del mod
  modAC        String?
  activo       Boolean         @default(true)
  creadoEn     DateTime        @default(now())

  desbloqueos CocheDesbloqueado[]

  @@map("coches")
}

model CocheDesbloqueado {
  id       String   @id @default(cuid())
  userId   String
  cocheId  String
  creadoEn DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  coche Coche @relation(fields: [cocheId], references: [id], onDelete: Cascade)

  @@unique([userId, cocheId])
  @@map("coches_desbloqueados")
}

model LogAccionAdmin {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  accion       String
  detalle      String?
  creadoEn     DateTime @default(now())

  admin  User @relation("AdminAcciones", fields: [adminId], references: [id])
  target User @relation("TargetAcciones", fields: [targetUserId], references: [id])

  @@map("log_acciones_admin")
}

model Queja {
  id     String      @id @default(cuid())
  tipo   TipoQueja
  estado EstadoQueja @default(ABIERTA)

  denuncianteId String
  denunciante   User   @relation("QuejaDenunciante", fields: [denuncianteId], references: [id])

  denunciadoId String?
  denunciado   User?   @relation("QuejaDenunciado", fields: [denunciadoId], references: [id])

  carreraId String?
  carrera   Carrera? @relation(fields: [carreraId], references: [id])

  titulo         String
  descripcion    String
  vuelta         Int?
  linkRepeticion String?

  pruebas PruebaQueja[]

  resolucion        String?
  sancion           TipoSancion?
  puntosPenalizados Int?
  diasSuspension    Int?
  resueltaPor       String?
  fechaResolucion   DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("quejas")
}

model PruebaQueja {
  id          String   @id @default(cuid())
  quejaId     String
  queja       Queja    @relation(fields: [quejaId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  descripcion String
  linkPrueba  String?
  creadoEn    DateTime @default(now())

  @@map("pruebas_queja")
}

model SyncLog {
  id          String   @id @default(cuid())
  ejecutadoEn DateTime @default(now())
  creadas     Int
  omitidas    Int
  errores     String?
  tipo        String   @default("AUTOMATICA")

  @@map("sync_logs")
}

model Clase {
  id            String       @id @default(cuid())
  titulo        String
  descripcion   String?
  disciplina    Disciplina
  youtubeUrl    String
  duracionMin   Int?
  orden         Int          @default(0)
  publicada     Boolean      @default(false)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  vistas        ClaseVista[]

  @@map("clases")
}

model Patrocinador {
  id            String                  @id @default(cuid())
  nombre        String
  descripcion   String?
  logoUrl       String?
  linkExterno   String?
  ubicaciones   UbicacionPatrocinador[]
  activo        Boolean                 @default(true)
  esColaborador Boolean                 @default(false)
  orden         Int                     @default(0)
  creadoEn      DateTime                @default(now())
  actualizadoEn DateTime                @updatedAt

  @@map("patrocinadores")
}

model ClaseVista {
  id       String   @id @default(cuid())
  userId   String
  claseId  String
  vistoCEn DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clase    Clase    @relation(fields: [claseId], references: [id], onDelete: Cascade)

  @@unique([userId, claseId])
  @@map("clases_vistas")
}

// ── Equipos, liga por equipos y temporadas ─────────────────────────────────────

enum RolEquipo {
  LIDER
  PILOTO
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoPropuesta {
  PENDIENTE
  REVISANDO
  ACEPTADA
  RECHAZADA
}

// Temporadas fijas: T1 enero→abril, T2 mayo→agosto, T3 septiembre→diciembre
model Temporada {
  id              String   @id @default(cuid())
  numero          Int // 1, 2 o 3
  anio            Int
  fechaInicio     DateTime
  fechaFin        DateTime
  activa          Boolean  @default(false)
  cocheEquipoId   String? // coche asignado por el admin para esta temporada
  equipoGanadorId String? // se rellena al cerrar la temporada
  creadoEn        DateTime @default(now())

  cocheEquipo   CocheEquipo?      @relation(fields: [cocheEquipoId], references: [id], onDelete: SetNull)
  equipoGanador Equipo?           @relation("TemporadaGanador", fields: [equipoGanadorId], references: [id], onDelete: SetNull)
  campeonatos   Campeonato[]
  puntosEquipo  PuntosEquipoMes[]
  propuestas    PropuestaEquipo[]

  @@unique([numero, anio])
  @@map("temporadas")
}

model Equipo {
  id            String   @id @default(cuid())
  nombre        String   @unique
  descripcion   String?
  logoUrl       String?
  colorPrimario String? // hex, ej: #FF0000
  liderId       String
  activo        Boolean  @default(true) // false = disuelto (se conserva por el histórico de puntos)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  lider             User                @relation("LiderEquipo", fields: [liderId], references: [id])
  miembros          MiembroEquipo[]
  invitaciones      InvitacionEquipo[]
  puntosMes         PuntosEquipoMes[]
  mensajes          MensajeEquipo[]
  propuestas        PropuestaEquipo[]
  skins             SkinEquipo[]
  inscripciones     InscripcionEquipo[]
  resultados        Resultado[]
  temporadasGanadas Temporada[]         @relation("TemporadaGanador")

  @@map("equipos")
}

model MiembroEquipo {
  id         String    @id @default(cuid())
  equipoId   String
  userId     String    @unique // un piloto solo puede estar en un equipo
  rol        RolEquipo @default(PILOTO)
  fechaUnion DateTime  @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("miembros_equipo")
}

model InvitacionEquipo {
  id         String           @id @default(cuid())
  equipoId   String
  invitadoId String
  estado     EstadoInvitacion @default(PENDIENTE)
  creadoEn   DateTime         @default(now())

  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  invitado User   @relation("InvitacionesRecibidas", fields: [invitadoId], references: [id], onDelete: Cascade)

  @@unique([equipoId, invitadoId])
  @@map("invitaciones_equipo")
}

model PuntosEquipoMes {
  id          String @id @default(cuid())
  equipoId    String
  temporadaId String
  mes         Int // 1-12
  anio        Int
  puntos      Float  @default(0)
  posicion    Int?

  equipo    Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  temporada Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  @@unique([equipoId, mes, anio])
  @@map("puntos_equipo_mes")
}

// Garaje de equipo — independiente del garaje individual (no comparte coches con `Coche`)
model CocheEquipo {
  id           String   @id @default(cuid())
  nombre       String
  descripcion  String?
  imagenBase   String? // imagen del coche sin skin
  linkDescarga String? // link de descarga del mod
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  temporadas Temporada[]
  skins      SkinEquipo[]

  @@map("coches_equipo")
}

model SkinEquipo {
  id            String   @id @default(cuid())
  cocheEquipoId String
  equipoId      String
  imagenSkin    String? // URL de la skin personalizada del equipo
  colorPrimario String?
  creadoEn      DateTime @default(now())

  cocheEquipo CocheEquipo @relation(fields: [cocheEquipoId], references: [id], onDelete: Cascade)
  equipo      Equipo      @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([cocheEquipoId, equipoId])
  @@map("skins_equipo")
}

model MensajeEquipo {
  id        String   @id @default(cuid())
  equipoId  String
  userId    String
  contenido String
  creadoEn  DateTime @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([equipoId, creadoEn])
  @@map("mensajes_equipo")
}

model MensajeDirecto {
  id             String   @id @default(cuid())
  remitenteId    String
  destinatarioId String
  contenido      String
  leido          Boolean  @default(false)
  creadoEn       DateTime @default(now())

  remitente    User @relation("MensajesEnviados", fields: [remitenteId], references: [id], onDelete: Cascade)
  destinatario User @relation("MensajesRecibidos", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([remitenteId, destinatarioId, creadoEn])
  @@index([destinatarioId, leido])
  @@map("mensajes_directos")
}

model PropuestaEquipo {
  id             String          @id @default(cuid())
  equipoId       String
  liderId        String
  temporadaId    String
  titulo         String
  descripcion    String
  estado         EstadoPropuesta @default(PENDIENTE)
  respuestaAdmin String?
  creadoEn       DateTime        @default(now())
  respondidoEn   DateTime?

  equipo    Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  lider     User      @relation(fields: [liderId], references: [id], onDelete: Cascade)
  temporada Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  @@unique([equipoId, temporadaId]) // una propuesta por equipo por temporada
  @@map("propuestas_equipo")
}

model InscripcionEquipo {
  id               String            @id @default(cuid())
  campeonatoId     String
  equipoId         String
  estado           EstadoInscripcion @default(PENDIENTE)
  fechaInscripcion DateTime          @default(now())

  campeonato Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  equipo     Equipo     @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([campeonatoId, equipoId])
  @@map("inscripciones_equipo")
}

// ── Programa de referidos ────────────────────────────────────────────────────

model CodigoReferido {
  id          String        @id @default(cuid())
  codigo      String        @unique // ej: "APEX-ASIER-4821"
  creadoPorId String
  creadoPor   User          @relation("CodigosCreados", fields: [creadoPorId], references: [id])
  usos        UsoReferido[]
  activo      Boolean       @default(true)
  creadoEn    DateTime      @default(now())

  @@index([creadoPorId])
  @@map("codigos_referido")
}

model UsoReferido {
  id             String             @id @default(cuid())
  codigoId       String
  codigo         CodigoReferido     @relation(fields: [codigoId], references: [id])
  referidoId     String             @unique // un usuario solo puede ser referido una vez
  referido       User               @relation("ReferidoPor", fields: [referidoId], references: [id])
  referidorId    String
  referidor      User               @relation("ReferidosHechos", fields: [referidorId], references: [id])
  fechaInicio    DateTime           @default(now())
  mesesActivos   Int                @default(0) // meses que ha pagado el referido
  comisionTotal  Float              @default(0) // comisión acumulada total (12% × meses)
  comisionPagada Float              @default(0) // ya liquidada
  activo         Boolean            @default(true) // false cuando llega a 12 meses o cancela
  creadoEn       DateTime           @default(now())
  comisiones     ComisionReferido[]

  @@index([referidorId])
  @@map("usos_referido")
}

model SaldoReferidor {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  saldoPendiente    Float     @default(0) // comisión acumulada sin liquidar
  saldoPagado       Float     @default(0) // total liquidado históricamente
  ultimaLiquidacion DateTime?
  actualizadoEn     DateTime  @updatedAt

  @@map("saldos_referidor")
}

// Una fila por cada pago del referido que genera comisión. saleId único = webhook idempotente.
model ComisionReferido {
  id          String      @id @default(cuid())
  usoId       String
  uso         UsoReferido @relation(fields: [usoId], references: [id])
  referidorId String
  referidor   User        @relation("ComisionesReferidor", fields: [referidorId], references: [id])
  saleId      String      @unique // id del pago de PayPal (PAYMENT.SALE.COMPLETED)
  precioPlan  Float
  importe     Float
  creadoEn    DateTime    @default(now())

  @@index([referidorId, creadoEn])
  @@map("comisiones_referido")
}

model LiquidacionReferido {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("LiquidacionesReferidor", fields: [userId], references: [id])
  adminId           String
  admin             User     @relation("LiquidacionesAdmin", fields: [adminId], references: [id])
  importeLiquidado  Float // saldo pendiente que se liquida
  precioSuscripcion Float // parte que cubre su propia suscripción
  cashPagado        Float // max(0, importeLiquidado - precioSuscripcion)
  creadoEn          DateTime @default(now())

  @@index([userId])
  @@map("liquidaciones_referido")
}
