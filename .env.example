# ── Críticas (el servidor avisa al arrancar si faltan) ─────────────────────────────────────────
# Secreto de NextAuth: genera uno con  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=tu-secreto-muy-seguro-aqui-cambiar-en-produccion
# Alias antiguo de NEXTAUTH_SECRET (solo si no se define el anterior)
# SECRET=
# URL pública: se usa en enlaces de emails, CORS del socket y CSP (WebSocket propio)
NEXTAUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/apex_db

# Emails (Resend). Sin ella la app funciona, pero no se envían emails y quedan desactivadas la
# recuperación de contraseña y la verificación de email.
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Las cuentas creadas antes de esta fecha se dan por verificadas (por defecto 2026-10-25)
# VERIFICACION_EMAIL_DESDE=2026-10-25T00:00:00Z

# PayPal Sandbox — developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# 'sandbox' para pruebas; cualquier otro valor (o vacío) = producción
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_MODE=sandbox
# Nombres antiguos de los Plan IDs estándar (se usan solo si faltan los *_NEW_PLAN_ID)
# PAYPAL_PLAN_ROOKIE= / PAYPAL_PLAN_AMATEUR= / PAYPAL_PLAN_PRO= / PAYPAL_PLAN_ELITE=
# NEXT_PUBLIC_PAYPAL_ROOKIE_PLAN_ID= / NEXT_PUBLIC_PAYPAL_AMATEUR_PLAN_ID= / NEXT_PUBLIC_PAYPAL_PRO_PLAN_ID= / NEXT_PUBLIC_PAYPAL_ELITE_PLAN_ID=

# PayPal Plan IDs estándar
NEXT_PUBLIC_PAYPAL_ROOKIE_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_NEW_PLAN_ID=P-...

# PayPal Plan IDs "Founder" — para inscritos en la temporada de iniciación que pagan dentro de la ventana Founder (120h)
NEXT_PUBLIC_PAYPAL_ROOKIE_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_FOUNDER_PLAN_ID=P-...

# PayPal Plan IDs "Referido" — primer mes con -10% para quien se registra con un código de referido.
# Crear cada plan en PayPal con 2 ciclos: TRIAL (1 mes, precio rebajado) + REGULAR (precio normal, sin fin),
# así PayPal pasa solo al precio completo desde el 2º mes. Si no están configurados, se cobra el precio normal.
# Fundador: 4.5 / 9 / 13.5 / 22.5 € → luego 5 / 10 / 15 / 25 €
NEXT_PUBLIC_PAYPAL_ROOKIE_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_REFERIDO_PLAN_ID=
# Estándar: 6.3 / 10.8 / 17.1 / 27 € → luego 7 / 12 / 19 / 30 €
NEXT_PUBLIC_PAYPAL_ROOKIE_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_REFERIDO_NEW_PLAN_ID=

# PayPal Plan IDs "Transición de equipo" — primer mes -20% al pasar de un Equipo Founder a plan individual
# (no acumulable con el referido: se aplica el mayor). Mismo esquema TRIAL + REGULAR. Opcionales.
# Founder: 4 / 8 / 12 / 20 € → luego 5 / 10 / 15 / 25 €
NEXT_PUBLIC_PAYPAL_ROOKIE_EQUIPO20_FOUNDER_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_EQUIPO20_FOUNDER_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_EQUIPO20_FOUNDER_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_EQUIPO20_FOUNDER_PLAN_ID=
# Estándar: 5.6 / 9.6 / 15.2 / 24 € → luego 7 / 12 / 19 / 30 €
NEXT_PUBLIC_PAYPAL_ROOKIE_EQUIPO20_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_EQUIPO20_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_EQUIPO20_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_EQUIPO20_NEW_PLAN_ID=

# PayPal Plan IDs del plan de equipo (lo paga el líder) — añadir cuando estén creados
NEXT_PUBLIC_PAYPAL_EQUIPO_FOUNDER_PLAN_ID=PLAN_ID_AQUI
NEXT_PUBLIC_PAYPAL_EQUIPO_ESTANDAR_PLAN_ID=PLAN_ID_AQUI

# ID del webhook en el dashboard de PayPal. Necesario para verificar firmas. En producción es
# OBLIGATORIO: sin él el webhook rechaza todos los eventos (503) y PayPal los reintenta.
PAYPAL_WEBHOOK_ID=

# Secreto de los endpoints /api/cron/*. OBLIGATORIO: sin él los crons responden 503.
CRON_SECRET=

# ── Arranque (Render, sin shell) ───────────────────────────────────────────────────────────────
# Ejecuta prisma db push (sin --accept-data-loss) y el seed al arrancar
RUN_SEED_ON_START=false
# Opcional: migra en el arranque los campeonatos con simulador distinto a ASSETTO_CORSA
RUN_MIGRATION_SIMULADOR=false
# Opcionales de mantenimiento de la Academia
RUN_CLEANUP_ACADEMIA=false
RUN_UPDATE_ACADEMIA_LINKS=false
# Heap (MB) de los procesos hijo del arranque, para no agotar los 512 MB de la instancia
BOOT_CHILD_HEAP_MB=256

PORT=3000

# Log de actividad: sal para el hash de IPs truncadas (sin ella no se guarda ipHash)
LOG_SALT=
