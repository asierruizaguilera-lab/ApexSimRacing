NEXTAUTH_SECRET=tu-secreto-muy-seguro-aqui-cambiar-en-produccion
NEXTAUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/apex_db

RESEND_API_KEY=re_xxxxxxxxxxxxx

# PayPal Sandbox — developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal Plan IDs "Normales" — se usan cuando ya se ocuparon las 30 plazas fundadoras
NEXT_PUBLIC_PAYPAL_ROOKIE_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_NEW_PLAN_ID=P-...

# PayPal Plan IDs "Fundador" — precios congelados de por vida para los primeros 30 pagadores
NEXT_PUBLIC_PAYPAL_ROOKIE_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_FOUNDER_PLAN_ID=P-...

# Cron secret — para el endpoint de expiración automática
CRON_SECRET=

# Opcional: migra en el arranque los campeonatos con simulador distinto a ASSETTO_CORSA
RUN_MIGRATION_SIMULADOR=false

PORT=3000
