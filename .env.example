PAYPAL_PLAN_AMATEUR=P-...
PAYPAL_PLAN_PRO=P-...
PAYPAL_PLAN_ELITE=P-...
NEXT_PUBLIC_PAYPAL_ROOKIE_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_PLAN_ID=P-...

# PayPal Plan IDs "Fundador" — precios congelados de por vida para los primeros 60 pagadores
