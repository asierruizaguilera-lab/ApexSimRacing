NEXTAUTH_SECRET=tu-secreto-muy-seguro-aqui-cambiar-en-produccion
NEXTAUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/apex_db

RESEND_API_KEY=re_xxxxxxxxxxxxx

# PayPal Sandbox — developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal Plan IDs "Normales" — se usan cuando ya se ocuparon las 30 plazas fundadoras
NEXT_PUBLIC_PAYPAL_ROOKIE_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_NEW_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_NEW_PLAN_ID=P-...

# PayPal Plan IDs "Fundador" — precios congelados de por vida para los primeros 30 pagadores
NEXT_PUBLIC_PAYPAL_ROOKIE_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_AMATEUR_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_PRO_FOUNDER_PLAN_ID=P-...
NEXT_PUBLIC_PAYPAL_ELITE_FOUNDER_PLAN_ID=P-...

# PayPal Plan IDs "Referido" — primer mes con -10% para quien se registra con un código de referido.
# Crear cada plan en PayPal con 2 ciclos: TRIAL (1 mes, precio rebajado) + REGULAR (precio normal, sin fin),
# así PayPal pasa solo al precio completo desde el 2º mes. Si no están configurados, se cobra el precio normal.
# Fundador: 4.5 / 9 / 13.5 / 22.5 € → luego 5 / 10 / 15 / 25 €
NEXT_PUBLIC_PAYPAL_ROOKIE_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_REFERIDO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_REFERIDO_PLAN_ID=
# Normal (sin plazas fundadoras): 6.3 / 10.8 / 17.1 / 27 € → luego 7 / 12 / 19 / 30 €
NEXT_PUBLIC_PAYPAL_ROOKIE_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_AMATEUR_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PRO_REFERIDO_NEW_PLAN_ID=
NEXT_PUBLIC_PAYPAL_ELITE_REFERIDO_NEW_PLAN_ID=

# ID del webhook en el dashboard de PayPal. Necesario para verificar firmas: sin él NO se
# acumulan comisiones de referido (evita que alguien falsifique pagos y se genere saldo).
PAYPAL_WEBHOOK_ID=

# Cron secret — para el endpoint de expiración automática
CRON_SECRET=

# Opcional: migra en el arranque los campeonatos con simulador distinto a ASSETTO_CORSA
RUN_MIGRATION_SIMULADOR=false

PORT=3000
